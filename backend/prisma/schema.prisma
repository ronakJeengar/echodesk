generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== WORKSPACE & AUTH ====================

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  fullName         String
  avatar           String?
  phone            String?
  role             GlobalRole        @default(USER)
  memberships      WorkspaceMember[]
  recordings       Recording[]
  assignedTasks    Task[]            @relation("AssignedTasks")
  createdTasks     Task[]            @relation("CreatedTasks")
  activityLogs     ActivityLog[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([email])
}

enum GlobalRole {
  USER
  SUPERADMIN
}

model Workspace {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  logo        String?
  industry    String?           // e.g., "HVAC", "Plumbing", "Electrical", "Real Estate", "General Contractor"
  members     WorkspaceMember[]
  customers   Customer[]
  recordings  Recording[]
  jobs        Job[]
  tasks       Task[]
  webhooks    WebhookSubscription[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([slug])
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(FIELD_TECH)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  FIELD_TECH
  READONLY
}

// ==================== CUSTOMER CRM ====================

model Customer {
  id          String        @id @default(uuid())
  workspaceId String
  name        String
  companyName String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  postalCode  String?
  notes       String?
  tags        String[]      @default([])
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobs        Job[]
  recordings  Recording[]
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([workspaceId])
  @@index([name])
  @@index([phone])
}

// ==================== VOICE RECORDINGS & AI EXTRACTIONS ====================

model Recording {
  id               String           @id @default(uuid())
  workspaceId      String
  createdById      String
  customerId       String?
  jobId            String?
  
  // Audio Metadata
  audioUrl         String           // S3 / R2 Storage Object URL or key
  audioDurationSec Float            // Duration in seconds
  audioFormat      String           @default("m4a") // aac, opus, m4a, mp3, wav
  fileSizeBytes    Int
  
  // Processing Lifecycle
  status           ProcessingStatus @default(PENDING)
  errorMessage     String?
  
  // Transcription
  rawTranscript    String?          @db.Text
  wordTimestamps   Json?            // Array of [{ word, start, end, confidence }]
  
  // Relations
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User             @relation(fields: [createdById], references: [id])
  customer         Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  job              Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  extractedData    ExtractedData?
  tasks            Task[]
  activities       ActivityLog[]
  
  recordedAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([workspaceId])
  @@index([createdById])
  @@index([customerId])
  @@index([status])
  @@index([recordedAt])
}

enum ProcessingStatus {
  PENDING
  UPLOADING
  TRANSCRIBING
  EXTRACTING
  COMPLETED
  FAILED
}

model ExtractedData {
  id               String    @id @default(uuid())
  recordingId      String    @unique
  recording        Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  
  // AI Structured Insights
  executiveSummary String    @db.Text
  sentiment        Sentiment @default(NEUTRAL)
  confidenceScore  Float     @default(1.0)
  
  // Extracted Entities (Structured JSON)
  customerInfo     Json?     // { name, company, phone, address, email }
  jobDetails       Json?     // { category, title, description, laborHours, status, priority }
  partsAndServices Json?     // [{ name, quantity, unitCost }]
  financials       Json?     // { quotedAmount, isPaid, paymentMethod }
  actionItems      Json?     // [{ title, dueDate, priority, assigneeRole }]
  
  rawPromptTokens  Int?
  completionTokens Int?
  llmModelUsed     String?   // e.g. "gpt-4o", "claude-3-5-sonnet"

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([recordingId])
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  URGENT
}

// ==================== JOBS & FIELD WORKFLOW ====================

model Job {
  id          String     @id @default(uuid())
  workspaceId String
  customerId  String
  title       String
  description String?    @db.Text
  category    String?    // "HVAC Repair", "Plumbing Inspection", "Sales Discovery"
  status      JobStatus  @default(SCHEDULED)
  priority    Priority   @default(MEDIUM)
  
  quotedAmount Float?
  laborHours   Float?
  
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recordings  Recording[]
  tasks       Task[]
  
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([workspaceId])
  @@index([customerId])
  @@index([status])
}

enum JobStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==================== TASKS & ACTION ITEMS ====================

model Task {
  id           String     @id @default(uuid())
  workspaceId  String
  createdById  String
  assignedToId String?
  customerId   String?
  jobId        String?
  recordingId  String?

  title        String
  description  String?
  status       TaskStatus @default(TODO)
  priority     Priority   @default(MEDIUM)
  dueDate      DateTime?
  
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User       @relation("CreatedTasks", fields: [createdById], references: [id])
  assignedTo   User?      @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  job          Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  recording    Recording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([workspaceId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

// ==================== AUDIT LOGS ====================

model ActivityLog {
  id          String     @id @default(uuid())
  userId      String
  recordingId String?
  action      String     // e.g. "RECORDING_PROCESSED", "TASK_CREATED", "CUSTOMER_LINKED"
  metadata    Json?
  
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  recording   Recording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([userId])
  @@index([recordingId])
  @@index([createdAt])
}

// ==================== WEBHOOK SUBSCRIPTIONS ====================

model WebhookSubscription {
  id          String   @id @default(uuid())
  workspaceId String
  url         String
  secret      String
  events      String[] // ["recording.completed", "job.created", "customer.created"]
  isActive    Boolean  @default(true)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}


# ==================== APP & NETWORK ====================
PORT=5001
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ==================== DATABASE (PostgreSQL) ====================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/echodesk?schema=public"

# ==================== REDIS (BullMQ) ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== JWT AUTHENTICATION ====================
JWT_SECRET=echodesk_jwt_secret_dev_key_super_secure_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=echodesk_jwt_refresh_secret_dev_key_2026
JWT_REFRESH_EXPIRES_IN=30d

# ==================== OBJECT STORAGE (S3 / Cloudflare R2) ====================
# Driver: "s3" or "local" (for local file storage) or "mock"
STORAGE_DRIVER=mock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
S3_BUCKET_NAME=echodesk-audio-recordings
S3_ENDPOINT=
STORAGE_LOCAL_DIR=./uploads

# ==================== SPEECH-TO-TEXT (STT) ====================
# STT Provider: "deepgram", "whisper", or "mock"
STT_PROVIDER=mock
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# ==================== LLM EXTRACTION ====================
# LLM Provider: "openai", "anthropic", "gemini", or "mock"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o
